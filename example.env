# MongoDB Atlas (no `export` — Next.js does not parse shell exports)
DB_URL="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="rooted"

# Auth — generate secrets with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AES-256 key — must be 64 hex chars (32 bytes): openssl rand -hex 32
CRYPTO_KEY=""

# JWT signing secret
JWT_SECRET=""

# Optional: store uploads in S3 instead of Mongo GridFS
# S3_BUCKET=""
# S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://your-bucket.s3.amazonaws.com"
